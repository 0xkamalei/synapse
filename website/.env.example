# Environment variables for Synapse website
# Copy this file to .env and fill in your values

# Local data source directory (written by the Go server)
# Default: ~/dev/ob/synapse-data
# SYNAPSE_DATA_DIR=~/dev/ob/synapse-data

# Notion API (legacy, no longer required)
# NOTION_TOKEN=secret_xxx
# NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
