---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThoughtCard from "../components/ThoughtCard.astro";
import Heatmap from "../components/Heatmap.astro";
import TimelineScroll from "../components/TimelineScroll.astro";
import {
  buildThoughtYearMeta,
  loadAllThoughts,
  loadDailyCounts,
  loadThoughtsIndex,
} from "../lib/thoughts-data";

const thoughts = await loadAllThoughts();
const dailyCounts = await loadDailyCounts();
const thoughtsYearMeta = loadThoughtsIndex();
const thoughtYearMetaForClient =
  thoughtsYearMeta.length > 0 ? thoughtsYearMeta : buildThoughtYearMeta(thoughts);

// PERFORMANCE OPTIMIZATION:
// Only render initial batch on SSR to reduce HTML size and parse time
const INITIAL_RENDER_COUNT = 20; // First 20 thoughts rendered on server
const initialThoughts = thoughts.slice(0, INITIAL_RENDER_COUNT);
---

<BaseLayout title="Thoughts">
  <div class="container">
      <TimelineScroll thoughts={thoughts as any} />
      <main class="main-content">
        <section class="hero">
          <a href="/" class="back-link">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to Home
          </a>
          <h1>My Thoughts</h1>
          <p class="hero-subtitle text-muted">
            A collection of ideas, insights, and moments from across the web.
          </p>
        </section>

        <section class="activity-section">
          <!-- Heatmap loads its data from data attribute -->
          <Heatmap data={dailyCounts} />
        </section>

        <section class="timeline-section">
          <div class="timeline-header flex-between">
            <h2 class="section-title">Recent Thoughts</h2>
            <div id="filter-indicator" class="filter-badge hidden">
              <span id="filter-date-text"></span>
              <button id="clear-filter" class="material-symbols-outlined"
                >close</button
              >
            </div>
          </div>

          {
            thoughts.length === 0 ? (
              <div class="empty-state">
                <span class="empty-icon">📝</span>
                <p>No thoughts yet</p>
                <p class="text-small text-muted">
                  Start collecting from X.com, Bilibili, or other supported platforms
                </p>
              </div>
            ) : (
              <>
                {/* Initial render - All users see the same initial batch */}
                <div class="timeline" id="thoughts-timeline">
                  {initialThoughts.map((thought) => (
                    <ThoughtCard thought={thought as any} />
                  ))}
                </div>
                
                {/* Loading indicator for lazy loading */}
                <div id="loading-indicator" class="loading-indicator hidden">
                  <div class="spinner-small"></div>
                  <span>Loading more thoughts...</span>
                </div>
                
                {/* Sentinel element for intersection observer */}
                <div id="load-more-sentinel" class="load-more-sentinel"></div>
              </>
            )
          }

        </section>
      </main>
    </div>
</BaseLayout>

<script
  define:vars={{
    initialThoughtsData: initialThoughts,
    thoughtYearMetaData: thoughtYearMetaForClient,
    thoughtsTotalCount: thoughts.length,
  }}
>
  window.__INITIAL_THOUGHTS__ = initialThoughtsData;
  window.__THOUGHT_YEAR_META__ = thoughtYearMetaData;
  window.__THOUGHTS_TOTAL__ = thoughtsTotalCount;
</script>

<script>
  const INITIAL_THOUGHTS = (window as any).__INITIAL_THOUGHTS__ || [];
  const THOUGHT_YEAR_META = (window as any).__THOUGHT_YEAR_META__ || [];
  const THOUGHTS_TOTAL = Number((window as any).__THOUGHTS_TOTAL__ || 0);
  const THOUGHTS_BY_YEAR_BASE = "/data/thoughts-by-year";

  const timeline = document.getElementById("thoughts-timeline");
  const loadingIndicator = document.getElementById("loading-indicator");
  const sentinel = document.getElementById("load-more-sentinel");

  // Lazy loading state
  const BATCH_SIZE = 20;
  const INITIAL_RENDER = 20;
  let currentIndex = Math.min(INITIAL_RENDER, THOUGHTS_TOTAL);
  let isLoading = false;
  let hasReachedLimit = false;

  const thoughtsData: any[] = [];
  const thoughtKeySet = new Set<string>();
  const yearCache = new Map<string, any[]>();
  const loadedYears = new Set<string>();
  const yearStartIndex = new Map<string, number>();

  let cumulativeIndex = 0;
  THOUGHT_YEAR_META.forEach((entry: any) => {
    yearStartIndex.set(String(entry.year), cumulativeIndex);
    cumulativeIndex += Number(entry.count) || 0;
  });

  function getThoughtKey(thought: any): string {
    if (thought.hashId) return `hash:${thought.hashId}`;
    if (thought.id) return `id:${thought.id}`;
    return `fallback:${thought.originalDate}:${thought.source}:${thought.title ?? ""}`;
  }

  function appendThoughtIfMissing(thought: any) {
    const key = getThoughtKey(thought);
    if (thoughtKeySet.has(key)) return;
    thoughtKeySet.add(key);
    thoughtsData.push(thought);
  }

  INITIAL_THOUGHTS.forEach((thought: any) => appendThoughtIfMissing(thought));

  async function loadYearThoughts(year: string): Promise<any[]> {
    if (yearCache.has(year)) {
      return yearCache.get(year) || [];
    }

    try {
      const response = await fetch(`${THOUGHTS_BY_YEAR_BASE}/${year}.json`, {
        cache: "force-cache",
      });

      if (!response.ok) {
        throw new Error(`Failed to load thoughts for year ${year}: ${response.status}`);
      }

      const data = await response.json();
      const normalized = Array.isArray(data) ? data : [];
      yearCache.set(year, normalized);
      return normalized;
    } catch (error) {
      console.error(error);
      yearCache.set(year, []);
      return [];
    }
  }

  async function ensureThoughtsLoadedUntil(targetIndex: number) {
    if (targetIndex < thoughtsData.length) {
      return;
    }

    for (const entry of THOUGHT_YEAR_META) {
      const year = String(entry.year);

      if (loadedYears.has(year)) {
        continue;
      }

      const yearThoughts = await loadYearThoughts(year);
      loadedYears.add(year);
      yearThoughts.forEach((thought: any) => appendThoughtIfMissing(thought));

      if (targetIndex < thoughtsData.length) {
        return;
      }
    }
  }

  function getMaxVisibleIndex(): number {
    return THOUGHTS_TOTAL;
  }

  function applyReachedLimitState(maxIndex: number) {
    if (currentIndex < maxIndex) {
      return;
    }

    hasReachedLimit = true;
    sentinel?.classList.add("hidden");
  }

  // Create ThoughtCard HTML from thought data
  function createThoughtCardHTML(thought: any): string {
    const sourceClass = thought.source.toLowerCase();
    const formattedDate = new Date(thought.originalDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
    const dateISO = thought.originalDate.split("T")[0];

    const images = Array.isArray(thought.images) ? thought.images : [];
    const videos = Array.isArray(thought.videos) ? thought.videos : [];
    const tags = Array.isArray(thought.tags) ? thought.tags : [];

    const mediaHTML = (images.length > 0 || videos.length > 0)
      ? `<div class="card-media">
          ${images.map((img: string) => `<img src="${img}" alt="" loading="lazy" />`).join("")}
          ${videos.map((vid: string) => `<video src="${vid}" controls preload="none"></video>`).join("")}
        </div>`
      : "";

    const tagsHTML = tags.length > 0
      ? `<div class="card-tags">
          ${tags.map((tag: string) => `<span class="tag">${tag}</span>`).join("")}
        </div>`
      : "";

    const originalLinkHTML = thought.originalUrl && thought.originalUrl.startsWith("https://")
      ? `<a href="${thought.originalUrl}" target="_blank" rel="noopener" class="original-link">View original →</a>`
      : "";

    return `
      <article class="thought-card" data-date="${dateISO}">
        <header class="card-header">
          <span class="badge ${sourceClass}">${thought.source}</span>
          <time datetime="${thought.originalDate}" class="text-muted text-small">
            ${formattedDate}
          </time>
        </header>
        <div class="card-content">
          <p>${thought.content}</p>
          ${mediaHTML}
        </div>
        <footer class="card-footer">
          ${tagsHTML}
          ${originalLinkHTML}
        </footer>
      </article>
    `;
  }

  function renderBatch(startIndex: number, endIndex: number) {
    const batch = thoughtsData.slice(startIndex, endIndex);
    batch.forEach((thought) => {
      const cardHTML = createThoughtCardHTML(thought);
      timeline?.insertAdjacentHTML("beforeend", cardHTML);
    });
  }

  // Load more thoughts
  async function loadMoreThoughts() {
    if (isLoading || hasReachedLimit) return;

    const maxIndex = getMaxVisibleIndex();

    if (currentIndex >= maxIndex) {
      applyReachedLimitState(maxIndex);
      return;
    }

    isLoading = true;
    loadingIndicator?.classList.remove("hidden");

    try {
      const endIndex = Math.min(currentIndex + BATCH_SIZE, maxIndex);
      await ensureThoughtsLoadedUntil(endIndex - 1);
      renderBatch(currentIndex, endIndex);
      currentIndex = Math.min(endIndex, thoughtsData.length);
      applyReachedLimitState(maxIndex);
    } finally {
      isLoading = false;
      loadingIndicator?.classList.add("hidden");
    }
  }

  async function resolveTargetIndex(year?: string, month?: string): Promise<number> {
    if (!year) {
      return -1;
    }

    const yearStart = yearStartIndex.get(year);
    if (yearStart === undefined) {
      return -1;
    }

    if (!month) {
      return yearStart;
    }

    const yearThoughts = await loadYearThoughts(year);
    const monthOffset = yearThoughts.findIndex((thought: any) => {
      const date = new Date(thought.originalDate);
      return (date.getMonth() + 1).toString() === month;
    });

    if (monthOffset === -1) {
      return yearStart;
    }

    return yearStart + monthOffset;
  }

  // Intersection Observer for infinite scroll
  const observerOptions = {
    root: null,
    rootMargin: '200px', // Start loading 200px before sentinel
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        void loadMoreThoughts();
      }
    });
  }, observerOptions);

  // Start observing for lazy loading
  if (sentinel) {
    observer.observe(sentinel);
  }

  // Filtering logic
  const indicator = document.getElementById("filter-indicator");
  const dateText = document.getElementById("filter-date-text");
  const clearBtn = document.getElementById("clear-filter");

  // Timeline Scroll Logic
  window.addEventListener("timeline-jump", async (e: any) => {
    const { target, year, month } = e.detail;

    if (target === "top") {
      window.scrollTo({ top: 0, behavior: "smooth" });
      return;
    }

    const targetIndex = await resolveTargetIndex(year, month);

    if (targetIndex !== -1) {
      // If target is beyond current rendered thoughts, load them
      if (targetIndex >= currentIndex) {
        // Show loading state if it's a large jump
        if (targetIndex - currentIndex > 50) {
          loadingIndicator?.classList.remove("hidden");
        }

        const maxIndex = getMaxVisibleIndex();
        const endIndex = Math.min(targetIndex + 10, maxIndex);
        await ensureThoughtsLoadedUntil(endIndex - 1);
        renderBatch(currentIndex, endIndex);

        currentIndex = Math.min(endIndex, thoughtsData.length);
        applyReachedLimitState(maxIndex);
        loadingIndicator?.classList.add("hidden");
      }

      // Find the element and scroll
      const cards = timeline?.children;
      if (cards && cards[targetIndex]) {
        cards[targetIndex].scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
  });
  
  // Scroll Spy for Timeline
  let scrollTimeout: any;
  window.addEventListener("scroll", () => {
    if (scrollTimeout) clearTimeout(scrollTimeout);
    
    scrollTimeout = setTimeout(() => {
        // Find visible thought card
        const cards = document.querySelectorAll(".thought-card");
        let visibleCard: HTMLElement | null = null;
        
        for (const card of cards) {
            const rect = card.getBoundingClientRect();
            if (rect.top >= 0 && rect.top < window.innerHeight / 2) {
                visibleCard = card as HTMLElement;
                break;
            }
        }
        
        // If no top card found (e.g. scrolled past), take the last one that was above
        if (!visibleCard && cards.length > 0) {
             // Simple fallback: check middle of screen
             const middleY = window.innerHeight / 2;
             for (const card of cards) {
                const rect = card.getBoundingClientRect();
                if (rect.top < middleY && rect.bottom > middleY) {
                    visibleCard = card as HTMLElement;
                    break;
                }
             }
        }

        if (visibleCard) {
            const dateStr = visibleCard.getAttribute("data-date");
            if (dateStr) {
                const date = new Date(dateStr);
                const year = date.getFullYear().toString();
                const month = (date.getMonth() + 1).toString();
                
                window.dispatchEvent(new CustomEvent("timeline-scroll-spy", {
                    detail: { year, month }
                }));
            }
        } else if (window.scrollY < 100) {
             window.dispatchEvent(new CustomEvent("timeline-scroll-spy", {
                    detail: { year: null, month: null } // Top
             }));
        }
    }, 100);
  });

  window.addEventListener("filter-date", (e: any) => {
    const selectedDate = e.detail;
    const cards = document.querySelectorAll(
      ".thought-card",
    ) as NodeListOf<HTMLElement>;

    if (selectedDate) {
      indicator?.classList.remove("hidden");
      if (dateText) dateText.textContent = `Filtered by ${selectedDate}`;

      cards.forEach((card) => {
        if (card.dataset.date === selectedDate) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    } else {
      clearFilter();
    }
  });

  clearBtn?.addEventListener("click", clearFilter);

  function clearFilter() {
    indicator?.classList.add("hidden");
    const cards = document.querySelectorAll(
      ".thought-card",
    ) as NodeListOf<HTMLElement>;
    cards.forEach((card) => card.classList.remove("hidden"));
    window.dispatchEvent(new CustomEvent("clear-calendar-selection"));
  }
</script>

<style is:global>
  .hidden {
    display: none !important;
  }
</style>

<style>
  @keyframes rotation {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding-top: var(--space-4);
    position: relative; /* For Timeline positioning */
  }

  .main-content {
    min-width: 0;
    width: 100%;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
    color: var(--md-on-surface-variant);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--md-primary);
  }

  .back-link .material-symbols-outlined {
    font-size: 1.125rem;
  }

  .hero {
    margin-bottom: var(--space-10);
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    max-width: 600px;
  }

  .activity-section {
    margin-bottom: var(--space-8);
  }

  .timeline-section {
    margin-bottom: var(--space-10);
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--md-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .filter-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .filter-badge button {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
  }

  .filter-badge button:hover {
    opacity: 0.7;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12);
    background: var(--md-surface-container-low);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--md-outline-variant);
  }

  .empty-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-4);
    opacity: 0.5;
  }

  /* Lazy Loading Styles */
  .loading-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    color: var(--md-on-surface-variant);
  }

  .spinner-small {
    width: 24px;
    height: 24px;
    border: 3px solid var(--md-secondary-container);
    border-bottom-color: var(--md-primary);
    border-radius: 50%;
    animation: rotation 1s linear infinite;
  }

  .load-more-sentinel {
    height: 20px;
    visibility: hidden;
  }

  /* Component Lazy Loading */
  .lazy-load-component {
    position: relative;
    min-height: 100px;
  }

  .component-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-8);
    color: var(--md-on-surface-variant);
    font-size: 0.875rem;
  }

  .component-content {
    transition: opacity 0.3s ease;
  }

  .component-content.hidden {
    opacity: 0;
    height: 0;
    overflow: hidden;
  }
</style>
